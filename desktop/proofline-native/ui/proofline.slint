import { ScrollView, VerticalBox } from "std-widgets.slint";

export struct HistoryEntry {
    title: string,
    meta: string,
    selected: bool,
    completed: bool,
}

export struct ChangedFileEntry {
    path: string,
    additions: string,
    deletions: string,
    evidence: string,
}

export struct ValidationEntry {
    command: string,
    elapsed: string,
    passed: bool,
}

component RailTask inherits Rectangle {
    in property <HistoryEntry> task;
    callback select();
    height: 43px;
    background: task.selected ? #f3f3f2 : #ffffff;
    border-radius: 7px;

    Rectangle {
        x: 0px;
        width: task.selected ? 3px : 0px;
        height: parent.height;
        background: #ff5a1f;
    }
    Text {
        x: 11px;
        y: 8px;
        width: parent.width - 37px;
        text: task.title;
        color: #303236;
        font-size: 12px;
    }
    TouchArea { clicked => { root.select(); } }
    Text {
        x: 11px;
        y: 25px;
        width: parent.width - 37px;
        text: task.meta;
        color: #85878b;
        font-size: 10px;
    }
    Text {
        x: parent.width - 22px;
        y: 15px;
        text: task.completed ? "✓" : "○";
        color: task.completed ? #42a36f : #a6a7a9;
        font-size: 14px;
    }
}

component FileRow inherits Rectangle {
    in property <ChangedFileEntry> file;
    height: 22px;
    border-width: 0px;

    Text { x: 6px; y: 3px; text: "M"; color: #9f6b32; font-size: 10px; }
    Text { x: 27px; y: 3px; width: 216px; text: file.path; color: #3e4248; font-family: "Cascadia Mono"; font-size: 10px; }
    Text { x: 251px; y: 3px; width: 42px; text: file.additions; color: #31935c; font-family: "Cascadia Mono"; font-size: 10px; }
    Text { x: 293px; y: 3px; width: 42px; text: file.deletions; color: #e35043; font-family: "Cascadia Mono"; font-size: 10px; }
    Text { x: 335px; y: 3px; width: parent.width - 345px; text: file.evidence; color: #787b80; font-size: 10px; }
    Rectangle { y: parent.height - 1px; width: parent.width; height: 1px; background: #e9e8e6; }
}

component ValidationRow inherits Rectangle {
    in property <ValidationEntry> check;
    height: 17px;
    Text { x: 4px; y: 1px; text: check.passed ? "✓" : "!"; color: check.passed ? #3b9e68 : #d95e4c; font-size: 10px; }
    Text { x: 29px; y: 1px; text: check.command; color: #44484d; font-family: "Cascadia Mono"; font-size: 9px; }
    Text { x: parent.width - 29px; y: 1px; width: 24px; horizontal-alignment: right; text: check.elapsed; color: #7e8083; font-size: 9px; }
}

export component ProoflineApp inherits Window {
    title: "Proofline for Spark — Native Spike";
    preferred-width: 1100px;
    preferred-height: 650px;
    background: #ffffff;

    in property <[HistoryEntry]> history;
    in property <string> task-title;
    in property <string> completion-meta;
    in property <string> summary;
    in property <[ChangedFileEntry]> changed-files;
    in property <[ValidationEntry]> validation;
    in property <string> model-steps;
    in property <string> branch;
    in property <string> checkpoint;
    in property <string> elapsed;
    in property <string> tokens;
    in property <string> pricing;
    in property <string> network-gate;
    in-out property <bool> activity-expanded: false;
    callback select-task(int);
    callback toggle-activity();

    Rectangle {
        x: 0px;
        y: 0px;
        width: 235px;
        height: 607px;
        background: #fbfbfa;
        border-color: #e5e5e3;
        border-width: 0px;

        Image { x: 22px; y: 20px; width: 30px; height: 30px; source: @image-url("../../proofline/assets/proofline-mark.png"); image-fit: contain; }
        Text { x: 62px; y: 20px; text: "Proofline"; color: #25272b; font-size: 15px; font-weight: 600; }
        Text { x: 62px; y: 40px; text: "for Spark"; color: #73757a; font-size: 10px; }
        Text { x: 22px; y: 82px; text: "Today"; color: #777a7e; font-size: 11px; }

        ScrollView {
            x: 11px;
            y: 106px;
            width: parent.width - 19px;
            height: parent.height - 165px;
            VerticalBox {
                width: 211px;
                spacing: 5px;
                for task[i] in root.history : RailTask { task: task; width: 211px; select => { root.select-task(i); } }
                Text { height: 27px; text: "This week"; color: #777a7e; font-size: 11px; vertical-alignment: bottom; }
                RailTask { task: { title: "Add export to JSON", meta: "Yesterday · 35s", selected: false, completed: true }; width: 211px; }
                RailTask { task: { title: "Optimize index queries", meta: "Yesterday · 42s", selected: false, completed: true }; width: 211px; }
                RailTask { task: { title: "Introduce retention job", meta: "Mon · 29s", selected: false, completed: false }; width: 211px; }
            }
        }
        Text { x: 22px; y: parent.height - 32px; text: "⚙   ♙"; color: #777a7e; font-size: 14px; }
        Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: #e5e5e3; }
    }

    Rectangle {
        x: 235px;
        width: 865px;
        height: 607px;
        background: #ffffff;

        ScrollView {
            x: 55px;
            y: 34px;
            width: parent.width - 110px;
            height: 430px;
            VerticalBox {
                width: parent.width;
                spacing: 0px;
                Text { height: 17px; text: root.completion-meta; color: #3c9d68; font-size: 10px; font-weight: 600; }
                Text { height: 42px; text: root.task-title; color: #25262a; font-family: "Georgia"; font-size: 32px; }
                Text { height: 31px; width: parent.width; text: root.summary; color: #4d5055; font-size: 11px; wrap: word-wrap; }
                Rectangle { height: 9px; }
                Rectangle { height: 31px; width: 128px; background: #ff5a1f; border-radius: 6px;
                    Text { x: 12px; y: 8px; text: "Review changes  →"; color: #ffffff; font-size: 10px; font-weight: 600; }
                }
                Rectangle { height: 11px; }
                Text { height: 19px; text: "Changed files  " + root.changed-files.length; color: #34363a; font-size: 11px; font-weight: 600; }
                Rectangle { height: 1px; background: #e9e8e6; }
                for file in root.changed-files : FileRow { file: file; width: parent.width; }
                Rectangle { height: 6px; }
                Text { height: 18px; text: "Validation   ✓  All checks passed"; color: #34363a; font-size: 11px; font-weight: 600; }
                for check in root.validation : ValidationRow { check: check; width: parent.width; }
                Rectangle { height: 6px; }
                Rectangle { height: root.activity-expanded ? 53px : 32px; background: #ffffff; border-color: #e1e1df; border-width: 1px; border-radius: 6px;
                    Text { x: 13px; y: 9px; text: (root.activity-expanded ? "⌄" : "›") + "   How Spark worked"; color: #383a3e; font-size: 10px; }
                    Text { x: 141px; y: 10px; text: "Model steps, tool calls, and reasoning (collapsed)"; color: #85878b; font-size: 9px; }
                    Text { x: parent.width - 51px; y: 10px; text: root.model-steps; color: #77797d; font-size: 9px; }
                    Text { x: 21px; y: 31px; text: root.activity-expanded ? "Fixture-only evidence. No tools, reasoning trace, or provider data is connected." : ""; color: #85878b; font-size: 9px; }
                    TouchArea { clicked => { root.toggle-activity(); } }
                }
                Rectangle { height: 9px; }
            }
        }

        Rectangle {
            x: 55px;
            y: 501px;
            width: parent.width - 110px;
            height: 90px;
            background: #ffffff;
            border-color: #a8a8a5;
            border-width: 1px;
            border-radius: 7px;
            Text { x: 15px; y: 14px; text: "What should Spark do next?"; color: #95979b; font-size: 13px; }
            Rectangle { x: 10px; y: 49px; width: parent.width - 56px; height: 27px; background: #f7f7f6; border-radius: 5px; }
            Text { x: 20px; y: 57px; text: "Model  GPT-5.3-Codex-Spark  ⌄     Reasoning  Medium  ⌄     Workspace  Local (full access)  ⌄"; color: #64676b; font-size: 10px; }
            Text { x: parent.width - 36px; y: 54px; text: "↑"; color: #a5a6a8; font-size: 18px; }
        }
    }

    Rectangle {
        y: 607px;
        width: 1100px;
        height: 43px;
        background: #fbfbfa;
        border-color: #e5e5e3;
        border-width: 0px;
        Text { x: 22px; y: 15px; text: "⌘  " + root.branch; color: #575a5f; font-size: 10px; }
        Text { x: 110px; y: 15px; text: "Checkpoint  " + root.checkpoint; color: #575a5f; font-size: 10px; }
        Text { x: 264px; y: 15px; text: "◷  Elapsed  " + root.elapsed; color: #575a5f; font-size: 10px; }
        Text { x: 396px; y: 15px; text: "◇  Tokens  " + root.tokens; color: #575a5f; font-size: 10px; }
        Text { x: 612px; y: 15px; text: "◇  Pricing  " + root.pricing; color: #575a5f; font-size: 10px; }
        Text { x: parent.width - 196px; y: 15px; text: "●  " + root.network-gate; color: #b27a32; font-size: 10px; }
        Rectangle { width: parent.width; height: 1px; background: #e5e5e3; }
    }
}
