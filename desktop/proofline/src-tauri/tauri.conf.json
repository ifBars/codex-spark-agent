{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proofline for Spark",
  "version": "0.1.0",
  "identifier": "dev.spark.proofline",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{"title": "Proofline for Spark", "width": 1280, "height": 860, "minWidth": 960, "minHeight": 640, "create": false}],
    "security": {"csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"}
  },
  "bundle": {"active": false}
}
