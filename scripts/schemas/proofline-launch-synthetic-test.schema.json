{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifbars.dev/schemas/proofline-launch-synthetic-test.schema.json",
  "title": "Proofline launch calibration synthetic self-test",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "synthetic_test",
    "countable",
    "evidence_class",
    "build_attestation",
    "fixture_attestation",
    "timing_evidence_available",
    "checks"
  ],
  "properties": {
    "schema": { "const": "spark.proofline.launch-calibration.synthetic-test.v1" },
    "synthetic_test": { "const": true },
    "countable": { "const": false },
    "evidence_class": { "const": "synthetic_test_only" },
    "build_attestation": { "const": "synthetic-test-only" },
    "fixture_attestation": { "const": "synthetic-test-only" },
    "timing_evidence_available": { "const": false },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nearest_rank",
        "all_attempt_denominator",
        "privacy_projection",
        "owned_process_cleanup"
      ],
      "properties": {
        "nearest_rank": { "type": "boolean" },
        "all_attempt_denominator": { "type": "boolean" },
        "privacy_projection": { "type": "boolean" },
        "owned_process_cleanup": { "const": "not_exercised" }
      }
    }
  }
}
